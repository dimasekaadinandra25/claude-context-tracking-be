# Timezone Configuration
TZ=UTC                                  # Timezone for the application (DO NOT CHANGE - must be UTC)

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=claude_usage
DB_SSLMODE=disable

# Database Connection Pool Configuration
DB_MAX_CONNS=25                    # Maximum number of connections in the pool (default: 4)
DB_MIN_CONNS=5                     # Minimum number of idle connections (default: 0)
DB_MAX_CONN_LIFETIME=1h            # Maximum lifetime of a connection (default: 1h)
DB_MAX_CONN_IDLE_TIME=30m          # Maximum idle time before closing (default: 30m)
DB_HEALTH_CHECK_PERIOD=1m          # Interval for connection health checks (default: 1m)
DB_CONNECT_TIMEOUT=5s              # Timeout for establishing new connections (default: 5s)

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-min-32-characters
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

API_KEY_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Security Settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=30m

# Seeded admin (make seed)
SEED_ADMIN_EMAIL=admin@claude-usage.local
SEED_ADMIN_PASSWORD=change-me

# Daily report image (reporter service)
# Webhooks: a comma-separated list of URLs, or a JSON list for gateways that need headers or fields.
# Discord (discord.com/api/webhooks/...) and Telegram (api.telegram.org/bot<token>/sendPhoto?chat_id=<id>)
# are detected from the URL. Anything else gets multipart fields "file" (the PNG) and "message".
# WhatsApp through a gateway, e.g.:
# REPORT_WEBHOOKS='[{"url":"https://api.fonnte.com/send","headers":{"Authorization":"<token>"},"fields":{"target":"62812xxxx"}}]'
REPORT_WEBHOOKS=
REPORT_TIME=09:00                  # local time to send, HH:MM (24h)
REPORT_TZ=Asia/Jakarta
REPORT_THEME=dark                  # dark or light
REPORT_LOCALE=en-US                # id-ID shows 97,3% with a comma
REPORT_MESSAGE=Claude usage report {date}
REPORT_EMAIL=admin@claude-usage.local   # a dashboard admin the reporter signs in as
REPORT_PASSWORD=

# Integration tests (make test-db)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claude_usage_test?sslmode=disable
